# Environment variables for /etc/systemd/system/gitlab-pipeline-runner.service
# Copy to /etc/gitlab-pipeline-runner/runner.env and restrict permissions (chmod 640, chown root:pipeline-runner).

# Persistent signing key for dashboard sessions and CSRF tokens (generate with: openssl rand -hex 32)
SESSION_SECRET_KEY="replace-with-openssl-rand-hex-32"

# Optional override for config.yaml webhook.secret_token
# GITLAB_WEBHOOK_SECRET="replace-with-gitlab-webhook-secret"

# Optional service bind password referenced by auth.ldap.bind_password_env in config.yaml
# LDAP_BIND_PASSWORD="replace-with-ldap-service-account-password"

# Optional database password referenced by database.password_env in config.yaml (PostgreSQL / MariaDB)
# RUNNER_DB_PASSWORD="replace-with-database-password"

# Network binding overrides (defaults to server.host and server.port in config.yaml)
PYTHON_HOST="127.0.0.1"
PYTHON_PORT="8090"

# Trusted reverse proxy IPs for X-Forwarded-Proto / X-Forwarded-Host
FORWARDED_ALLOW_IPS="127.0.0.1"

# Optional custom path to config.yaml (must end in .yaml or .yml)
# RUNNER_CONFIG_PATH="/opt/gitlab-pipeline-runner/config.yaml"
