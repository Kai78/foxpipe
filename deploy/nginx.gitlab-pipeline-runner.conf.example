# Optional Nginx reverse proxy for GitLab SSH Pipeline Runner (systemd service on 127.0.0.1:8090)
# Place in /etc/nginx/sites-available/gitlab-pipeline-runner and symlink into sites-enabled/.

server {
    listen 80;
    server_name pipelines.example.com;

    # Redirect HTTP to HTTPS (enable once TLS certificates are configured)
    # return 301 https://$host$request_uri;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
